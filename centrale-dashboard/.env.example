# All four sections are optional - an unconfigured one just shows as
# "not configured" in its tab instead of an empty table. Copy to .env.

# OSINT tab - your running flowsint-api instance.
FLOWSINT_API_URL=http://127.0.0.1:5001
FLOWSINT_USERNAME=
FLOWSINT_PASSWORD=

# Forensics tab - one or more "Label=/path/to/cases" pairs, comma-separated.
# Matches the ./cases directory each docker-compose.yml (IPED, autopsy)
# bind-mounts case output into.
FORENSICS_SOURCES=IPED=/path/to/IPED/cases,Autopsy=/path/to/autopsy/cases

# Pentest tab - Awesome-Pentest's lab/reports directory.
PENTEST_REPORTS_DIR=/path/to/Awesome-Pentest/lab/reports

# Blue-team tab - defaults to ~/.pcybox-orbis/pivot_queue.jsonl, only set
# this if you pointed export_pivots.py at a different --output-file.
BLUETEAM_PIVOT_FILE=
